{
  "_doc": "会話で育てる設定ファイル。chat.py の preferences_update JSON フィールドで Claude が書き込む。このファイルはサンプル。実際の設定は preferences.json に保存される（.gitignore 済み）。",
  "character_name": "Claude",
  "wake_words": ["ねえクロード", "クロード"],

  "_tts_entity_doc": "通常読み上げに使うHAのtts.*エンティティ。声・言語・速度・音量等はHA側のエンティティ設定を使用し、Embodied HAからは上書きしない。",
  "tts_entity": "tts.home_assistant_cloud",
  "sing_speaker": {"name": "春日部つむぎ", "style_id": 3008},
  "stt_provider": "stt.home_assistant_cloud",
  "stt_language": "ja-JP",

  "_camera_history_doc": "任意機能。trueのとき、設定済みカメラのJPEGを/tmpへ短時間だけ保存し、侵入中の同じカメラから履歴を振り返れる。LLMへ自動注入はしない。保存期間は1〜60分。",
  "camera_history_enabled": false,
  "camera_history_minutes": 10,

  "_cameras_doc": "entity: HAエンティティIDか独自の短いID（電脳体侵入時に使う）。HAエンティティなら entity = source = ha_entity でよい。go2rtcの場合は entity に独自IDを設定し ha_entity で画像取得先のHAカメラを指定する。",
  "cameras": [
    {
      "entity": "camera_tv",
      "source": "living_tv_stream",
      "room": "living",
      "label": "テレビ",
      "note": "HDDレコーダー出力。今何が放送されているか確認できる"
    },
    {
      "entity": "camera.living_room_entity_id",
      "source": "camera.living_room_entity_id",
      "ha_entity": "camera.living_room_entity_id",
      "room": "living",
      "label": "リビング",
      "note": "リビングの広角カメラ"
    }
  ],

  "_mics_doc": "マイク（耳）: 侵入して聴く実デバイス。entity は侵入時のID、source はRTSP URL。ハードウェア入力はgo2rtc等でRTSP配信する。stt_enabled で文字起こし対象を切り替える。",
  "mics": [
    {
      "entity": "mic_study",
      "source": "rtsp://homeassistant.local:8554/study_microphone",
      "room": "study",
      "label": "書斎マイク",
      "stt_enabled": true
    },
    {
      "entity": "mic_hallway",
      "source": "rtsp://homeassistant.local:8554/hallway_microphone",
      "room": "hallway",
      "label": "廊下マイク",
      "stt_enabled": true
    }
  ],

  "_video_media_doc": "映像ソース（観る）: 侵入不要で届くフレーム。id はメディア用 ID、source は camera_proxy / go2rtc / 直接 URL など。room は文脈用。",
  "video_media": [
    {
      "id": "capture_tv",
      "source": "camera.living_room_tv_proxy",
      "room": "living",
      "label": "テレビ映像",
      "note": "レコーダー/TVの画面"
    },
    {
      "id": "home_pc_screenshot",
      "source": "camera.study_pc_screenshot",
      "room": "study",
      "label": "書斎PC画面",
      "note": "スクリーンショットの取得元"
    }
  ],

  "_audio_media_doc": "音声ソース（聴く）: 侵入不要で届く音。id はメディア用 ID、source は音声取得元。video_media で対応する映像ソースを参照できる。",
  "audio_media": [
    {
      "id": "capture_tv_audio",
      "source": "capture_tv",
      "room": "living",
      "label": "テレビ音声",
      "note": "テレビ映像とペア",
      "video_media": "capture_tv"
    },
    {
      "id": "capture_pc_audio",
      "source": "capture_pc2",
      "room": "study",
      "label": "PC音声",
      "note": "PC画面の音",
      "video_media": "home_pc_screenshot"
    }
  ],

  "_speakers_doc": "スピーカーデバイス一覧。entity はHAの media_player entity_id（電脳体侵入時にも使う）。TTSエンティティはグローバルの tts_entity を参照する。",
  "speakers": [
    {
      "entity": "media_player.your_tts_media_player",
      "room": "study",
      "label": "書斎（Nest Mini）",
      "type": "tts",
      "note": "tts_entity はグローバル設定を使用"
    }
  ],

  "_entities_doc": "操作できる家電の対応表（口語の呼び方 → entity_id）。チャットで家電操作を頼まれたとき entity_id を引くのに使う。Web UIで編集・discover.pyで下書き生成・チャットの entities_add でも追記可。name は HA の friendly_name そのままでよい。",
  "entities": [
    {
      "name": "リビングのライト",
      "entity_id": "light.living_room",
      "note": ""
    }
  ],
  "presence": {
    "entity": "input_boolean.resident_home"
  },
  "policies": [
    "深夜1〜6時は発話しない（loop/explore に組み込み済み）"
  ],
  "_loop_schedule_doc": "自律ループ(loop.py)の定期実行間隔と、時間帯ごとの発火確率。loop_interval は秒。0-7時=night、22-24時=late、それ以外=day。Web UIの「高度な設定」タブから編集可能。",
  "loop_schedule": {
    "loop_interval": 1800,
    "day_probability": 100,
    "late_probability": 30,
    "night_probability": 10
  },

  "_sensors_doc": "自律ループ(loop)/会話(chat)で毎回コンテキストに渡す『おもなデバイス』センサーの定義。render-sensors.py が HA Template API で描画する。全エンティティは ha_get ツールで常時 pull 可能なので、ここに無い＝見えないではなく『自分から取りに行く対象』になるだけ。discover.py で下書きを自動生成できる。",
  "sensors": {
    "groups": [
      {
        "title": "人感センサー",
        "contexts": [
          "loop"
        ],
        "items": [
          {
            "label": "リビング",
            "entity": "binary_sensor.living_motion"
          },
          {
            "label": "廊下1",
            "entity": "binary_sensor.hall_motion_1",
            "note": "リビング誤反応あり"
          }
        ]
      },
      {
        "title": "温湿度",
        "contexts": [
          "loop"
        ],
        "items": [
          {
            "label": "リビング",
            "template": "{{ states('sensor.living_temp') }}℃ / {{ states('sensor.living_humidity') }}%"
          }
        ]
      },
      {
        "title": "テレビ",
        "contexts": [
          "loop"
        ],
        "items": [
          {
            "label": "最前面アプリ",
            "template": "{{ state_attr('media_player.android_tv_xxx','app_name') or state_attr('media_player.android_tv_xxx','source') or 'オフ' }}",
            "note": "HAのAndroid TV(ADB)統合のmedia_player。今見ているアプリ。要統合導入"
          }
        ]
      },
      {
        "contexts": [
          "chat"
        ],
        "items": [
          {
            "label": "在宅",
            "entity": "input_boolean.resident_home"
          },
          {
            "template": "人感→ リビング:{{ states('binary_sensor.living_motion') }}"
          }
        ]
      }
    ]
  },
  "ai_lounge": {
    "app_id": "",
    "installation_id": "",
    "auto_approve": false
  }
}
